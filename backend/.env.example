APP_NAME=Multi-Agent Job Assistant
APP_VERSION=0.1.0
APP_DEBUG=true
API_V1_PREFIX=/api/v1

ENVIRONMENT=development
LOG_LEVEL=DEBUG
LOG_FORMAT=console

LLM_PROVIDER=
LLM_MODEL=
NINE_ROUTER_API_KEY=
NINE_ROUTER_BASE_URL=

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="multi-agent-job-assistant"

QDRANT_URL=
QDRANT_API_KEY=

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5500","http://127.0.0.1:3000","http://127.0.0.1:5173","http://127.0.0.1:5500"]
BACKEND_CORS_ALLOW_CREDENTIALS=true

MAX_UPLOAD_SIZE_MB=10
ALLOWED_CV_CONTENT_TYPES=["application/pdf"]

STORAGE_DIR=storage
UPLOAD_DIR=storage/uploads
UPLOAD_CHUNK_SIZE_BYTES=1048576
MAX_PDF_PAGES=20

MIN_NATIVE_TEXT_CHARS_PER_PAGE=50

OCR_DPI=250
OCR_MIN_CONFIDENCE=0.5