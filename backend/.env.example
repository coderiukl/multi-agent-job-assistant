APP_NAME=Multi-Agent Job Assistant
APP_VERSION=0.1.0
ENVIRONMENT=development
APP_DEBUG=true

API_V1_PREFIX=/api/v1

LLM_PROVIDER=
LLM_MODEL=
NINE_ROUTER_API_KEY=
NINE_ROUTER_BASE_URL=

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
